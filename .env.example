# WASP Environment Configuration

PROJECT_NAME="WASP - Website Security Posture Auditor"
PROJECT_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Database (SQLite async via aiosqlite)
DATABASE_URL="sqlite+aiosqlite:///./auditor.db"

# Security & CORS
ALLOW_LOCAL_SCANS=true
RATE_LIMIT_PER_MINUTE=15
MAX_SCAN_TIMEOUT_SECONDS=20
